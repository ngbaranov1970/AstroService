# Образец корневого .env — его читает docker compose (и для подстановки
# ${...} в docker-compose.yml, и как env_file для контейнера api).
# Скопировать в .env и заполнить; сам .env в git не попадает.
#
# Это НЕ backend/.env: тот нужен для локального запуска через uv run.

# --- Postgres ---------------------------------------------------------------
# Пароль собирается в строку подключения (DATABASE_URL в docker-compose.yml),
# поэтому только латиница и цифры: @ : / ? # в пароле ломают разбор URL.
POSTGRES_USER=astro
POSTGRES_PASSWORD=
POSTGRES_DB=astro

# --- Домен ------------------------------------------------------------------
# Доменное имя (astroservice.ru) — Caddy сам выпустит сертификат Let's Encrypt.
# На время проверки по голому IP: SITE_ADDRESS=:80
SITE_ADDRESS=:80

# --- Приложение -------------------------------------------------------------
DEEPSEEK_API_KEY=

# Секрет из ссылки для тестеров: /?t=<это значение>. Пусто — тестером не
# станет никто, полный разбор закрыт.
WEB_TESTER_TOKEN=

# Доступ в /admin. Пароль не задан — админка отвечает 503 и не пускает
# никого: за ней даты и места рождения живых людей.
ADMIN_USER=admin
ADMIN_PASSWORD=

# INFO | DEBUG | WARNING | ERROR
LOG_LEVEL=INFO
