# Образец корневого .env — его читает docker compose (и для подстановки
# ${...} в docker-compose.yml, и как env_file для контейнера api).
# Скопировать в .env и заполнить; сам .env в git не попадает.
#
# Это НЕ backend/.env: тот нужен для локального запуска через uv run.

# --- Postgres ---------------------------------------------------------------
# Пароль собирается в строку подключения (DATABASE_URL в docker-compose.yml),
# поэтому только латиница и цифры: @ : / ? # в пароле ломают разбор URL.
POSTGRES_USER=astro
POSTGRES_PASSWORD=
POSTGRES_DB=astro

# --- Домен ------------------------------------------------------------------
# Доменное имя — Caddy сам выпустит сертификат Let's Encrypt. Имён может быть
# несколько через запятую: сертификат выпускается на каждое, отвечают все.
# На время проверки по голому IP: SITE_ADDRESS=:80
#
# На проде три имени: astrozvezdochet.ru (канонический, он же в кабинетах
# ЮKassa и VK), www к нему и старый ngbaranov.top. Последние два Caddyfile
# уводит редиректом на канонический, но в списке они нужны — без имени
# сертификат не выпустится, и редирект отдаст ошибку TLS вместо перехода.
# SITE_ADDRESS=astrozvezdochet.ru, www.astrozvezdochet.ru, ngbaranov.top
SITE_ADDRESS=:80

# --- Приложение -------------------------------------------------------------
DEEPSEEK_API_KEY=

# Ключ OpenRouter (openrouter.ai/keys): нужен только scripts/compare_models.py
# для сравнения DeepSeek с Anthropic и OpenAI. На проде не нужен.
# OPENROUTER_API_KEY=

# Потолок расходов: сколько НЕОПЛАЧЕННЫХ генераций разрешено всему сервису
# за сутки (оплаченные идут мимо него). Единственная защита от трат, пока
# личный лимит ниже выключен. 3000 ≈ 250 ₽ в сутки.
# Пустым не оставлять: приложение не стартует (так и задумано).
DAILY_GENERATION_LIMIT=3000

# Сколько бесплатных разборов даётся одному человеку. 0 — не ограничивать
# (так с 01.09.2026: упереться в лимит до первой покупки нельзя).
# Вернуть счётчик — поставить число и перезапустить контейнер.
FREE_NATAL_LIMIT=0

# Доступ в /admin. Пароль не задан — админка отвечает 503 и не пускает
# никого: за ней даты и места рождения живых людей.
ADMIN_USER=admin
ADMIN_PASSWORD=

# VK id владельца: ему сообщество пишет об оплате VIP-заказа. Пусто =
# уведомление клиенту уходит, владельцу нет.
VIP_OWNER_VK_ID=

# --- VK Mini App ------------------------------------------------------------
# ID приложения и «Защищённый ключ» из настроек приложения VK (Разработка →
# Ключи доступа): ключом проверяется подпись параметров запуска. Пусто = вход
# из VK выключен, работает только cookie-ветка стенда.
VK_APP_ID=
VK_SECURE_KEY=

# ID приложения VK ID — вход в приложение из обычного браузера. Это ОТДЕЛЬНОЕ
# приложение, не то, что в VK_APP_ID: VK ID заводится в своём кабинете
# («сервис подключения авторизации»). Секрета к нему нет, обмен идёт по PKCE.
VK_ID_CLIENT_ID=

# Ключ подписи наших сессионных токенов (?s=<JWT>). Свой, не от VK.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Числовой ID сообщества (адрес вида vk.ru/club123456). Пусто = блок
# подписки в приложении не рисуется. Через сообщество идут все продажи:
# внутри Mini App продавать нельзя.
VK_GROUP_ID=

# --- ЮKassa -----------------------------------------------------------------
# Идентификатор магазина и секретный ключ из личного кабинета: вместе —
# Basic Auth к api.yookassa.ru. Пусто = кнопка покупки не показывается вовсе.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Внешний адрес сайта со схемой и без слеша на конце: от него строятся
# ссылка на оплату и return_url. Из Mini App человек уходит платить во
# внешний браузер, поэтому адрес обязан быть абсолютным.
#
# Меняется НЕ в одиночку: адрес вебхука прописан в кабинете ЮKassa, и если
# поменять здесь, а там нет — уведомления об оплате будут уходить на старый
# домен, а разбор не откроется. Список того, что переключается пакетом, —
# в docs/astro-context.md, «Два домена».
PUBLIC_BASE_URL=https://astrozvezdochet.ru

# Откуда раздаётся Vue-фронт: туда страница возврата уводит человека после
# оплаты. Пусто — тот же домен, путь /app/ (так на проде).
#
# В разработке заполнять обязательно: стенд отвечает на 127.0.0.1:8000, а
# фронт живёт на dev-сервере Vite, и без адреса возврат приходит на бэкенд,
# где /app/ нет — человек видит 404 вместо купленного разбора.
#   APP_BASE_URL=http://localhost:5173/app/
APP_BASE_URL=

# INFO | DEBUG | WARNING | ERROR
LOG_LEVEL=INFO
