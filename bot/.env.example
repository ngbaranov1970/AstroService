# Переменные окружения бота. Скопировать в bot/.env и заполнить.
# Сам .env в git не попадает (см. .gitignore) — здесь только имена
# переменных, чтобы состав настроек не жил в одной голове и на одном VPS.
#
# ВАЖНО: это состав НА МОМЕНТ ПЕРЕЕЗДА из BotHoroscope, то есть то, что
# нужно скопированному коду, чтобы он завёлся как раньше. По мере пересадки
# бота на общий backend часть переменных отсюда уйдёт — см. пометки.

# --- Telegram --------------------------------------------------------
# Токен от @BotFather. У НОВОГО бота он свой: два процесса с одним токеном
# несовместимы (Telegram отдаёт обновления только одному и роняет второго),
# поэтому пока старый бот жив на проде, здесь должен стоять токен тестового.
BOT_TOKEN=

# --- DeepSeek --------------------------------------------------------
# УЙДЁТ: в backend уже есть свой клиент (app/llm/client.py) и своя
# настройка DEEPSEEK_API_KEY в backend/.env. Держать ключ в двух местах —
# гарантия того, что однажды поменяют только один.
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=

# --- Хранилище -------------------------------------------------------
# УЙДЁТ: SQLite-файл заменяется общим Postgres (DATABASE_URL из backend).
DB_PATH=bot.db

# Кеш готовых гороскопов по знакам. Не критичен: при недоступном Redis
# HoroscopeService откатывается на базу (см. services/horoscope.py).
REDIS_URL=redis://localhost:6379/0
