# Секреты — только через env_file в рантайме, в слоях образа им не место.
.env

# Данные — рантайм (volume на сервере), не часть образа.
bot.db

# Локальные артефакты: в образе pip ставит пакеты сам.
.venv/
__pycache__/
*.pyc

# История git не нужна рантайму и зря инвалидирует кеш COPY при коммитах.
.git/
.gitignore

# Не используется внутри контейнера.
test/
deploy/
CLAUDE.md
