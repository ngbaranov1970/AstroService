# Шаблон backend/.env. Скопировать и заполнить:
#   cp .env.example .env
#
# Здесь перечислены только переменные, которые уже читает app/config.py.
# Остальные (YOOKASSA_*) добавятся сюда вместе с кодом, который их
# использует.

# Ключ DeepSeek — обязателен, https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Подключение к Postgres — обязательно, дефолта в коде нет намеренно.
# Схема должна содержать драйвер asyncpg, иначе движок не поднимется.
# Пароль со спецсимволами (@ : / #) надо URL-кодировать.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/astro

# Печатать каждый SQL-запрос в консоль. Нужно точечно, при отладке запросов.
DB_ECHO=false

# Режим окружения: dev | prod
APP_ENV=dev

# Подробные ошибки и автоперезагрузка. В prod держать false.
DEBUG=false

# Порог логов: DEBUG | INFO | WARNING | ERROR.
# DEBUG показывает в том числе HTTP-запросы к DeepSeek — включать точечно.
LOG_LEVEL=INFO

# --- Веб-стенд для обкатки промптов ---------------------------------------

# Секрет ссылки для тестеров: открыл /?t=<это значение> — получил is_tester
# (полный разбор без оплаты, без лимитов на бесплатные). Пусто = механизм
# выключен, тестером не станет никто.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(24))"
WEB_TESTER_TOKEN=

# Логин и пароль админки (/admin, HTTP Basic Auth). Пустой пароль = админка
# отдаёт 503 и не пускает никого: в ней лежат даты и места рождения живых
# людей, открытой в интернете она быть не должна.
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- VK Mini App -----------------------------------------------------------

# ID приложения и «Защищённый ключ» — VK, настройки приложения,
# Разработка → Ключи доступа. Ключом проверяется подпись параметров запуска;
# пусто = вход из VK выключен, работает только cookie-ветка стенда.
# Защищённый ключ ≠ сервисный ключ доступа: у второго другое назначение.
VK_APP_ID=
VK_SECURE_KEY=

# Ключ подписи наших сессионных токенов (?s=<JWT> в адресе). Свой, не от VK:
# роли разные, и менять их надо независимо. Смена разлогинивает всех.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
