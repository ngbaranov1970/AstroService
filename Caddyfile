# Прокси перед приложением. Домен подставляется из SITE_ADDRESS (см. .env):
# доменное имя включает автоматический HTTPS, ":80" — режим проверки по IP.
{$SITE_ADDRESS} {
	encode zstd gzip

	# Статику (один style.css) отдаёт само приложение через StaticFiles:
	# копировать её в контейнер Caddy ради одного файла — лишняя сборка и
	# ещё одно место, где она может устареть.
	reverse_proxy api:8000

	log {
		# Персональных данных здесь нет: адреса вида /r/<token> токен не
		# раскрывает ничего сверх того, что и так в ссылке.
		output stdout
		format console
	}
}
