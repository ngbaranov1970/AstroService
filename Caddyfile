# Прокси перед приложением. Домен подставляется из SITE_ADDRESS (см. .env):
# доменное имя включает автоматический HTTPS, ":80" — режим проверки по IP.
{$SITE_ADDRESS} {
	encode zstd gzip

	# Канонический адрес один — astrozvezdochet.ru, остальные имена уводим на
	# него: одинаковое содержимое на двух адресах делит вес в поиске.
	# ngbaranov.top не отключаем — на нём ссылки в уже выданных разборах,
	# редирект сохраняет путь, и /r/<token> открывается на новом домене.
	#
	# Вебхук из редиректа исключён: уведомления старого магазина 1432173
	# приходят POST'ом на ngbaranov.top, а за 301 POST не повторяют — деньги
	# списались бы, а отчёт не открылся.
	@legacy {
		host ngbaranov.top www.astrozvezdochet.ru
		not path /webhooks/*
	}
	handle @legacy {
		redir https://astrozvezdochet.ru{uri} permanent
	}

	# Файлы сборки фронта: в имени каждого лежит хеш содержимого, новая сборка
	# даёт новое имя — старое можно держать в кеше сколько угодно.
	header /app/assets/* Cache-Control "public, max-age=31536000, immutable"

	# Точка входа, наоборот, всегда одна и та же /app/index.html: закешируйся
	# она — люди остались бы на старом фронте до очистки кеша вебвью.
	header /app/ Cache-Control "no-cache"

	# Статику стенда и собранный фронт отдаёт само приложение через
	# StaticFiles: копировать их в контейнер Caddy — лишняя сборка и ещё одно
	# место, где они могут устареть.
	handle {
		reverse_proxy api:8000
	}

	log {
		# Персональных данных здесь нет: адреса вида /r/<token> токен не
		# раскрывает ничего сверх того, что и так в ссылке.
		output stdout
		format console
	}
}
